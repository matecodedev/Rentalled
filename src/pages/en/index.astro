---
import About from "../../components/About.astro";
import Clients from "../../components/Clients.astro";
import Contact from "../../components/Contact.astro";
import Faq from "../../components/Faq.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import Portfolio from "../../components/Portfolio.astro";
import Problem from "../../components/Problem.astro";
import Process from "../../components/Process.astro";
import Services from "../../components/Services.astro";
import { getPage } from "@content/site";
import BaseLayout from "@layouts/BaseLayout.astro";

const page = getPage("en");
---

<BaseLayout page={page} skipLabel={page.sections.shell.skipLabel} bodyClass="landing-page">
  <Header page={page} />
  <main id="main" class="landing-main">
    <Hero page={page} />
    <About page={page} />
    <Problem page={page} />
    <Services page={page} />
    <Process page={page} />
    <Portfolio page={page} />
    <Clients page={page} />
    <Faq page={page} />
    <Contact page={page} />
  </main>
  <Footer page={page} />
</BaseLayout>

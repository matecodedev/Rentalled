---
import { translate, type LocalizedPage } from "@content/site";

export interface Props {
  page: LocalizedPage;
}

const { page } = Astro.props;
const locale = page.locale;
---

<section id="services" class="section-shell" aria-labelledby="services-title">
  <div class="section-heading">
    <p class="eyebrow">{page.sections.services.eyebrow}</p>
    <h2 id="services-title">{page.sections.services.title}</h2>
    <p class="section-body">{page.sections.services.body}</p>
  </div>

  <div class="card-grid service-grid">
    {page.services.map((service, index) => (
      <article class="content-card">
        <span class="card-index">{String(index + 1).padStart(2, "0")}</span>
        <h3>{translate(service.title, locale)}</h3>
        <p>{translate(service.description, locale)}</p>
      </article>
    ))}
  </div>
</section>

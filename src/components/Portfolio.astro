---
import { site, translate, type LocalizedPage } from "@content/site";
import Icon from "./Icon.astro";

export interface Props {
  page: LocalizedPage;
}

const { page } = Astro.props;
const locale = page.locale;
const portfolio = page.sections.portfolio;
const sizeClass: Record<string, string> = { big: "rl-pf-big", tall: "rl-pf-tall", std: "" };
const zoomLabel = locale === "es" ? "Ampliar imagen" : "Enlarge image";
---

<section id="portfolio" class="rl-section" aria-labelledby="portfolio-title">
  <div class="rl-pf-header rl-reveal">
    <div class="rl-section-head" style="margin-bottom:0;">
      <p class="eyebrow rl-eyebrow-accent">{portfolio.eyebrow}</p>
      <h2 id="portfolio-title" class="rl-section-title">{portfolio.title}</h2>
      <p class="rl-section-body">{portfolio.body}</p>
    </div>
    <a class="btn btn-ghost" href={site.contact.whatsappUrl} target="_blank" rel="noopener noreferrer">
      {portfolio.cta}
      <Icon name="arrow-up-right" size={16} />
    </a>
  </div>

  <div class="rl-pf-grid" data-pf-grid>
    {page.portfolio.map((item) => (
      <button
        type="button"
        class:list={["rl-pf-tile", sizeClass[item.size]]}
        data-lightbox={`/portfolio/${item.fileName}`}
        aria-label={`${translate(item.alt, locale)} — ${zoomLabel}`}
      >
        <img
          src={`/portfolio/${item.fileName}`}
          alt={translate(item.alt, locale)}
          loading="lazy"
          decoding="async"
        />
        <span class="rl-zoom" aria-hidden="true"><Icon name="arrow-up-right" size={18} /></span>
      </button>
    ))}
  </div>
</section>

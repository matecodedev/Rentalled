---
import { site, translate, type LocalizedPage } from "@content/site";
import BrandIcon from "./BrandIcon.astro";

export interface Props {
  page: LocalizedPage;
}

const { page } = Astro.props;
const locale = page.locale;
const brandLabel = locale === "es" ? `${site.name} inicio` : `${site.name} home`;
const hero = page.sections.hero;
const shell = page.sections.shell;
---

<header class="site-header" data-nav-root>
  <a class="brand-link" href="#hero" aria-label={brandLabel} translate="no">
    <img class="brand-logo" src="/logo.webp" alt="" width="165" height="200" decoding="async" fetchpriority="high" />
    <span class="brand-name">RENTAL <b>LED</b></span>
  </a>

  <button
    class="menu-toggle"
    type="button"
    aria-controls="site-menu"
    aria-expanded="false"
    aria-label={shell.menuOpenLabel}
    data-menu-toggle
    data-open-label={shell.menuOpenLabel}
    data-close-label={shell.menuCloseLabel}
  >
    <span data-menu-label>{shell.menuOpenLabel}</span>
  </button>

  <nav id="site-menu" class="site-nav" aria-label={shell.navLabel} data-menu-panel>
    <div class="nav-links">
      {page.nav.map((item) => <a href={item.href}>{translate(item.label, locale)}</a>)}
    </div>

    <div class="header-actions">
      <div class="language-pill" role="group" aria-label={shell.languageLabel}>
        <a href="/" hreflang="es" aria-current={locale === "es" ? "page" : undefined}>ES</a>
        <a href="/en/" hreflang="en" aria-current={locale === "en" ? "page" : undefined}>EN</a>
      </div>
      <a class="btn btn-sm btn-primary" href={site.contact.whatsappUrl} target="_blank" rel="noopener noreferrer">
        <BrandIcon name="whatsapp" size={15} />
        {hero.primaryCtaShort}
      </a>
    </div>
  </nav>
</header>

<script>
  import "../scripts/nav";
</script>
